{
  "name": "gamedatabase",
  "main": "src/index.js",
  "compatibility_date": "2025-10-01",
  "ai": { "binding": "AI" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "estante",
      "database_id": "54c68bd1-d6ff-4d48-a697-18cdc8b7ca2f"
    }
  ]
}
